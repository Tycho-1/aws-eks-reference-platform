# -----------------------------------------------------------------------------
# Personal / secret overrides — copy to terraform.tfvars.secrets (gitignored) and edit.
#
# First time in this environment:
#   cp terraform.tfvars.example terraform.tfvars
#   cp terraform.tfvars.secrets.example terraform.tfvars.secrets   # optional, for Flux
#
# Apply with secrets: terraform apply -var-file=terraform.tfvars.secrets
# Values in .secrets override terraform.tfvars.
# -----------------------------------------------------------------------------

# Enable Flux against your own fleet repo (must exist with at least one commit)
enable_flux_gitops = true
flux_git_url       = "https://github.com/<owner>/flux-fleet.git"
flux_path          = "clusters/jumbo-eks-dev"

# Option A — PAT auth (flux_token_auth = true): fine-grained token with Contents read/write on the repo
flux_token_auth   = true
flux_git_username = "<github-username>"
github_token      = "github_pat_xxx"

# Option B — SSH deploy key (flux_token_auth = false); add the public key as a deploy key with write access
# flux_git_url                = "ssh://git@github.com/<owner>/flux-fleet.git"
# flux_token_auth             = false
# github_ssh_private_key_path       = "/tmp/ed25519"
# github_ssh_private_key_passphrase = ""  # set if the key is encrypted; leave empty for passwordless keys
